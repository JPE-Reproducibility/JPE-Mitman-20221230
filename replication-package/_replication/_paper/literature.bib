@article{KMS11,
	abstract = {This paper explores asset pricing in economies where there is no direct insurance against idiosyncratic risks but other assets can be used for self-insurance, subject to exogenously-imposed borrowing limits. We analyze an endowment economy, based on Huggett (1993) [11], both with and without aggregate risk. Our main innovation is that we obtain full analytical tractability by studying the case with \&quot;maximally tight\&quot; borrowing constraints. We illustrate by looking at riskless bonds, equity, and the term structure of interest rates, and we show that the model can reproduce many features of observed asset prices when idiosyncratic risks are quantitatively reasonable.},
